{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/question-bank/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=600"
        }
      ]
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "{public/question-bank/**,public/assets/**,server/private-question-keys/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|question-bank/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
